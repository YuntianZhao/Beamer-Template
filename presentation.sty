\usepackage{libertinus-type1} % Use Libertinus font
\usepackage[upint]{libertinust1math} % Use Libertinus math font
\renewcommand{\sfdefault}{LibertinusSans-TLF}
\renewcommand{\familydefault}{\sfdefault}
\usepackage[scale=.85]{sourcecodepro} % Monospace font
\DeclareFontShape{T1}{LibertinusSans-TLF}{b}{it}{%
  <-> ssub * LibertinusSans-TLF/m/it}{}
\usepackage[cal=stixplain, scr=boondox, frak=euler]{mathalfa} % Lowercase and bold math alphabets
