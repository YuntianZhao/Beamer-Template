\definecolor{GitHubBorder}{HTML}{D0D7DE}
\definecolor{GitHubBlue}{HTML}{0969DA}
\definecolor{GitHubRed}{HTML}{CF222E}
\definecolor{GitHubGreen}{HTML}{1A7F37}
\definecolor{GitHubYellow}{HTML}{9A6700}
\definecolor{GitHubPurple}{HTML}{8250DF}
\definecolor{GitHubCodeComment}{HTML}{6E7781}
\definecolor{GitHubCodeKeyword}{HTML}{CF222E}
\definecolor{GitHubCodeString}{HTML}{0A3069}
\definecolor{GitHubCodeNumber}{HTML}{0550AE}
