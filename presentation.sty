% Set page and text colors
\setbeamercolor{background canvas}{bg=GitHubCanvas}
\setbeamercolor{normal text}{fg=GitHubFg,bg=GitHubCanvas}
\setbeamercolor{structure}{fg=GitHubBlue}
\setbeamercolor{alerted text}{fg=GitHubRed}
\setbeamercolor{example text}{fg=GitHubGreen}

% Set title color
\setbeamercolor{title}{fg=GitHubFg}
\setbeamercolor{subtitle}{fg=GitHubMuted}
\setbeamercolor{institute}{fg=GitHubMuted}
\setbeamercolor{framesubtitle}{fg=GitHubMuted}
\setbeamercolor{titlegraphic}{fg=GitHubFg}

% Set frame title color
\setbeamercolor{frametitle}{fg=GitHubFg}

% Set itemized-list item color
\setbeamercolor{itemize item}{fg=GitHubMuted} % First level
\setbeamercolor{itemize subitem}{fg=GitHubMuted} % Second level
\setbeamercolor{itemize subsubitem}{fg=GitHubMuted} % Third level

% Set numbered-list item color
\setbeamercolor{enumerate item}{fg=GitHubMuted} % First level
\setbeamercolor{enumerate subitem}{fg=GitHubMuted} % Second level
\setbeamercolor{enumerate subsubitem}{fg=GitHubMuted} % Third level

% Set theorem colors
\setbeamercolor{block title}{fg=GitHubFg,bg=GitHubCanvasSubtle} % Title
\setbeamercolor{block body}{fg=GitHubFg,bg=GitHubCanvasSubtle} % Body
\setbeamercolor{block title alerted}{fg=GitHubRed,bg=GitHubCanvasSubtle}
\setbeamercolor{block body alerted}{fg=GitHubFg,bg=GitHubCanvasSubtle}
\setbeamercolor{block title example}{fg=GitHubGreen,bg=GitHubCanvasSubtle}
\setbeamercolor{block body example}{fg=GitHubFg,bg=GitHubCanvasSubtle}

% Set footer color
\setbeamercolor{footline}{fg=GitHubMuted}

% Set button colors
\setbeamercolor{button}{fg=GitHubBlue, bg=GitHubCanvas}

% ---- Format title slide ----

% Enable advanced programming features
\usepackage{etoolbox}

% Define commands to insert slide URL
\newif\ifpresentationurlset
\newtoks\presentationurltoks
\newcommand*{\inserturl}{\the\presentationurltoks}
\newcommand*{\paperurl}[1]{%
  \global\presentationurltoks={#1}%
  \global\presentationurlsettrue}

\setbeamertemplate{title page}{%
  {\usebeamerfont{title}\usebeamercolor[fg]{title}\inserttitle\par}%
  \ifx\insertsubtitle\@empty\else%
    \vspace{2mm}%
    {\usebeamerfont{subtitle}\usebeamercolor[fg]{subtitle}\insertsubtitle\par}%
  \fi%
  {\color{GitHubFg}\rule{\textwidth}{1.5pt}\par}%
  \vspace{1.5cm}%
  {\usebeamerfont{author}\insertauthor\par}%
  \ifx\insertinstitute\@empty\else%
    \vspace{2mm}%
    {\usebeamerfont{institute}\usebeamercolor[fg]{institute}\insertinstitute\par}%
  \fi%
  \vspace{5mm}%
  {\usebeamerfont{date}\insertdate\par}%
  \ifpresentationurlset%
    \vspace{5mm}%
    {\color{GitHubMuted}\footnotesize Available at \url{\inserturl}\par}%
  \fi%
  \ifx\inserttitlegraphic\@empty\else%
    \vspace{5mm}%
    {\usebeamercolor[fg]{titlegraphic}\inserttitlegraphic\par}%
  \fi%
  \vfill}

% ---- Format lists ----

% Select itemized-list items
\setbeamertemplate{itemize item}{$\square$} % First level
\setbeamertemplate{itemize subitem}{\scalebox{1.25}{$\triangleright$}} % Second level
\setbeamertemplate{itemize subsubitem}{\textendash} % Third level
\providecommand{\labelitemiv}{}
\renewcommand{\labelitemiv}{$\cdot$} % Fourth level

% Select numbered-list items
\setbeamertemplate{enumerate item}[default] % First level
\setbeamertemplate{enumerate subitem}{\alph{enumii}.} % Second level
\setbeamertemplate{enumerate subsubitem}{\roman{enumiii}.} % Third level

% ---- Format figures and tables ----

% ---- Format code listings and algorithms ----

\usepackage{listings}
\lstdefinestyle{minimalcode}{
  basicstyle=\ttfamily\scriptsize,
  backgroundcolor=\color{GitHubCanvasSubtle},
  keywordstyle=\color{GitHubCodeKeyword},
  commentstyle=\color{GitHubCodeComment},
  stringstyle=\color{GitHubCodeString},
  numbers=left,
  numberstyle=\tiny\color{GitHubMuted},
  xleftmargin=2em,
  frame=none,
  showstringspaces=false,
  columns=fullflexible,
  keepspaces=true,
  tabsize=2,
  breaklines=true
}
\lstset{style=minimalcode}

\usepackage{algorithm}
\usepackage{algpseudocode}

% ---- Format figures and tables ----

% Allow graphics to specify max width and max height constraints
\usepackage[export]{adjustbox}

% Enhance table formatting
\usepackage{booktabs}

% Enable multiple rows in table
\usepackage{multirow}

% Enable multi-page tables in frames
\usepackage{xtab}

% ---- Format references ----

% Load biblatex with Chicago author-date style (biber backend)
\usepackage[backend=biber,authordate,sorting=nyt,%
  giveninits=true,uniquename=mininit,%
  isbn=false,url=false,doi=false,eprint=false]{biblatex-chicago}

% Remove the per-entry bibliography icon in beamer frames
\setbeamertemplate{bibliography item}{}

% Keep bibliography entries in the main foreground color so they remain
% legible in both light and dark themes (biblatex assigns distinct colors
% to author/title/journal fields by default, which breaks on dark canvas)
\setbeamercolor{bibliography entry author}{fg=GitHubFg}
\setbeamercolor{bibliography entry title}{fg=GitHubFg}
\setbeamercolor{bibliography entry note}{fg=GitHubFg}
\setbeamercolor{bibliography entry journal}{fg=GitHubFg}
\setbeamercolor{bibliography entry annotation}{fg=GitHubFg}
\setbeamercolor{bibliography entry location}{fg=GitHubFg}
\setbeamercolor{bibliography entry publisher}{fg=GitHubFg}
\setbeamercolor{bibliography entry editor}{fg=GitHubFg}
\setbeamercolor{bibliography entry edition}{fg=GitHubFg}
\setbeamercolor{bibliography entry volumes}{fg=GitHubFg}
\setbeamercolor{bibliography entry number}{fg=GitHubFg}
\setbeamercolor{bibliography entry series}{fg=GitHubFg}
\setbeamercolor{bibliography entry chapter}{fg=GitHubFg}
\setbeamercolor{bibliography entry pages}{fg=GitHubFg}
\setbeamercolor{bibliography entry type}{fg=GitHubFg}

% Customize captions
\setbeamerfont{caption}{size=\footnotesize}
\setbeamercolor{caption}{fg=GitHubFg}
\setbeamertemplate{caption}{\centering\usebeamerfont{caption}\usebeamercolor[fg]{caption}\insertcaption\par}
\AtBeginEnvironment{figure}{\setlength{\abovecaptionskip}{-5pt}\setlength{\belowcaptionskip}{0pt}}
\AtBeginEnvironment{table}{\setlength{\abovecaptionskip}{5pt}\setlength{\belowcaptionskip}{-5pt}}

\newcommand{\figurenote}[1]{\par{\footnotesize\singlespacing\color{GitHubMuted}#1\par}}

% ---- Format theorems ----

\setbeamertemplate{blocks}[default]

% Define additional theorems
\newtheorem{proposition}{Proposition}
\newtheorem{assumption}{Assumption}
\newtheorem{remark}{Remark}

% ---- Create section slide ----

\newcommand*{\heading}[1]{\LARGE\scshape\color{GitHubFg}\singlespacing #1}

% ---- Create last slide ----

\newcommand{\lastslide}{{\setbeamercolor{background canvas}{bg=GitHubCanvasSubtle}
    \begin{frame}
\end{frame}}}

% ---- Remove or insert slide numbers ----

\setbeamerfont{footline}{size=\scriptsize}

\ifgithubpagenumbers
\setbeamertemplate{footline}{%
  \hfill%
  \usebeamerfont{footline}\usebeamercolor[fg]{footline}%
  \makebox[0pt][r]{\insertframenumber{} / \inserttotalframenumber\hspace{5mm}}%
  \vspace{2mm}%
}
\else
\setbeamertemplate{footline}{}
\fi

% ---- Define shortcuts for pictograms ----

\newcommand{\up}{\textuparrow\,}
\newcommand{\down}{\textdownarrow\,}
\newcommand{\then}{$\rightsquigarrow\,$}
\newcommand{\so}{{$\Rightarrow\,$}}
