\definecolor{GitHubRed}{HTML}{F85149}
\definecolor{GitHubGreen}{HTML}{3FB950}
\definecolor{GitHubYellow}{HTML}{D29922}
\definecolor{GitHubPurple}{HTML}{A371F7}
\definecolor{GitHubCodeComment}{HTML}{8B949E}
\definecolor{GitHubCodeKeyword}{HTML}{FF7B72}
\definecolor{GitHubCodeString}{HTML}{A5D6FF}
\definecolor{GitHubCodeNumber}{HTML}{79C0FF}
\else
\definecolor{GitHubFg}{HTML}{1F2328}
\definecolor{GitHubMuted}{HTML}{656D76}
\definecolor{GitHubCanvas}{HTML}{FFFFFF}
\definecolor{GitHubCanvasSubtle}{HTML}{F6F8FA}
